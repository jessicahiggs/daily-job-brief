<?xml version="1.0" encoding="UTF-8"?>
<!-- macOS launchd template. Replace __HOME__ with your home path (echo $HOME),
     set the Hour you want it to run, then see SETUP.md to install it. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.user.daily-job-brief</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__HOME__/.claude/skills/daily-job-brief/scripts/daily-brief.sh</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>20</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>__HOME__/.daily-job-brief/launchd.out.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/.daily-job-brief/launchd.err.log</string>
</dict>
</plist>
